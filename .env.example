DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cwritelite
DEEPSEEK_API_KEY=
# Images: fal-ai/nano-banana-2 and fal-ai/nano-banana-2/edit.
FAL_KEY=
SEED_TONY_PASSWORD=123321
# Development only: preview image generation using the student's sketch.
CWRITE_LOCAL_MOCK_IMAGES=false
# Public deployment origin, used when image editing needs a local asset URL.
APP_BASE_URL=https://c-write-lite.vercel.app
# Selected video target: Doubao-Seedance-2.5 260628, through Volcengine Ark.
# ARK_API_KEY starts a Seedance task only after storage and the merge worker are also set.
# Until then, Generate video explains what is missing and does not create a paid task.
# The animation preview is not an MP4.
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
ARK_API_KEY=
# Finished MP4 storage and merge. These names are read by the video route.
# Leave them empty until the bucket and worker exist.
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
VIDEO_WORKER_URL=
VIDEO_WORKER_SECRET=
# Optional worker-only CDN allowlist, comma-separated hostnames. No wildcards or private addresses.
VIDEO_MEDIA_HOSTS=
# AI API inventory and future Seedance video integration:
# docs/AI_API_AND_VERCEL_SETUP.md
