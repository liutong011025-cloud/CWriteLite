{
  "name": "cwrite-lite",
  "version": "0.1.0",
  "packageManager": "npm@10.8.1",
  "private": true,
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "prisma@6.19.2": true,
    "sharp": true
  },
  "scripts": {
    "dev": "next dev --webpack -p 3010",
    "local": "node scripts/start-preview.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:generate": "prisma generate",
    "video:worker": "node --import tsx worker/video-worker.ts",
    "test:video": "node --import tsx scripts/verify-video.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fal-ai/client": "1.9.4",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@react-three/fiber": "^9.0.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^16.0.7",
    "ogl": "^1.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "three": "^0.170.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "yazl": "^3.3.1"
  }
}
