generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  username String @unique
  password String
  role String @default("student")
  email String?
  profile Json @default("{}")
  mapState Json @default("{}")
  vocabulary Json @default("[]")
  createdAt DateTime @default(now())
  sessions Session[]
  characters Character[]
  stories Story[]
  events ResearchEvent[]
  videoJobs VideoJob[]
}
model Session {
  token String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
}
model Character {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  age String @default("")
  species String @default("")
  appearance String @default("")
  traits String @default("")
  background String @default("")
  strength String @default("")
  challenge String @default("")
  imageUrl String @default("")
  spriteUrl String @default("")
  sketch String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Story {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String @default("Untitled adventure")
  status String @default("draft")
  stage String @default("characters")
  level Int @default(2)
  characterIds String[]
  characterSnapshots Json @default("[]")
  canvas Json @default("{\"nodes\":[],\"edges\":[]}")
  sections Json @default("[\"\",\"\",\"\",\"\",\"\"]")
  activeSection Int @default(0)
  content String @default("")
  pin Json?
  chapterIndex Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions Revision[]
  videoJobs VideoJob[]
}
model Revision {
  id String @id @default(cuid())
  storyId String
  story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
  sections Json
  createdAt DateTime @default(now())
}
model ResearchEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  storyId String?
  type String
  payload Json
  createdAt DateTime @default(now())
}
model VideoJob {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  storyId String
  story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
  revisionHash String
  model String
  plan Json
  status String @default("planning")
  errorCode String @default("")
  errorMessage String @default("")
  outputUrl String @default("")
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clips VideoClip[]
  @@unique([storyId, revisionHash])
  @@index([userId])
}
model VideoClip {
  id String @id @default(cuid())
  jobId String
  job VideoJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  sceneId String
  sequence Int
  duration Int @default(0)
  providerTaskId String @default("")
  status String @default("planned")
  sourceUrl String @default("")
  storedUrl String @default("")
  error String @default("")
  subtitle Json @default("{}")
  @@unique([jobId, sequence])
}
model WorkReview {
  id String @id @default(cuid())
  authorUsername String
  reviewerUsername String
  reviewerRole String @default("student")
  workType String @default("story")
  workTitle String?
  workContent String?
  content String
  readAt DateTime?
  createdAt DateTime @default(now())
}
model AssetGeneration {
  id String @id
  status String @default("processing")
  imageUrl String @default("")
  updatedAt DateTime @updatedAt
}
